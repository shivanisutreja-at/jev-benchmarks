# OpenRouter API Key for Jev model
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Efficia Backend API Base URL
EFFICIA_API_BASE_URL=https://platform.efficia.io

# Agent 1 (GPT-6 Luna) Configuration
EFFICIA_GPT_DEPLOYMENT_ID=your_gpt_deployment_id_here
EFFICIA_GPT_API_KEY=your_gpt_api_key_here

# Agent 2 (DeepSeek) Configuration
EFFICIA_DEEPSEEK_DEPLOYMENT_ID=your_deepseek_deployment_id_here
EFFICIA_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Agent 3 (Claude Sonnet) Configuration
EFFICIA_CLAUDE_DEPLOYMENT_ID=your_claude_deployment_id_here
EFFICIA_CLAUDE_API_KEY=your_claude_api_key_here

# Optional: print raw Efficia SSE events for every call (debugging)
# EFFICIA_DEBUG=1
